import logging
import stripe
from django.conf import settings
from django.http import HttpResponse
from django.views.decorators.csrf import csrf_exempt
from django.views.decorators.http import require_POST
from .services import change_order_status, InvalidTransition

logger = logging.getLogger(__name__)


@csrf_exempt
@require_POST
def stripe_webhook(request):
    try:
        event = stripe.Webhook.construct_event(
            request.body,
            request.META.get('HTTP_STRIPE_SIGNATURE', ''),
            settings.STRIPE_WEBHOOK_SECRET,
        )
    except (ValueError, stripe.SignatureVerificationError):
        return HttpResponse(status=400)  # forged or corrupted, reject

    if event['type'] in ('checkout.session.completed',
                         'checkout.session.async_payment_succeeded'):
        session = event['data']['object']
        if session['payment_status'] == 'paid':
            order_id = session['metadata'].get('order_id')
            try:
                change_order_status(int(order_id), 'paid')
            except InvalidTransition:
                # duplicate delivery, or order was cancelled before payment arrived
                logger.warning('Payment for order %s but transition not allowed', order_id)
            except Order.DoesNotExist:
                logger.error('Payment for unknown order %s', order_id)

    return HttpResponse(status=200)



